<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (API 31+). Same policy as backup_rules.xml: the
  journal database (birth date + private reflections) is excluded from both
  cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="saatan_database.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="saatan_database.db" />
    </device-transfer>
</data-extraction-rules>
